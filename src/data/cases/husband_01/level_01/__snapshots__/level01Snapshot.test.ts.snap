              "text": "Nồi cơm điện ở nhà nút bấm hơi khó dùng.",
              "time": "15/08/2026 08:10",
              "timestamp": "15/08/2026 08:10",
            },
            {
              "id": "msg_010_0010",
              "sender": "me",
              "text": "Mẹ rút điện rồi để nguội, đừng tháo ra nhé.",
              "time": "15/08/2026 08:13",
              "timestamp": "15/08/2026 08:13",
            },
            {
              "id": "msg_010_0011",
              "sender": "them",
              "text": "Mẹ để bố xem qua thôi chứ chưa sửa gì.",
              "time": "15/08/2026 08:16",
              "timestamp": "15/08/2026 08:16",
            },
            {
              "id": "msg_010_0012",
              "sender": "me",
              "text": "Để con gọi chỗ sửa quen hỏi trước đã.",
              "time": "15/08/2026 08:19",
              "timestamp": "15/08/2026 08:19",
            },
            {
              "id": "msg_010_0013",
              "sender": "them",
              "text": "Hai đứa thích ăn lạc rang hay lạc luộc?",
              "time": "20/08/2026 08:10",
              "timestamp": "20/08/2026 08:10",
            },
            {
              "id": "msg_010_0014",
              "sender": "me",
              "text": "Vợ con thích lạc luộc hơn mẹ ạ.",
              "time": "20/08/2026 08:13",
              "timestamp": "20/08/2026 08:13",
            },
            {
              "id": "msg_010_0015",
              "sender": "them",
              "text": "Mẹ nhớ rồi, có mẻ mới mẹ gửi.",
              "time": "20/08/2026 08:16",
              "timestamp": "20/08/2026 08:16",
            },
            {
              "id": "msg_010_0016",
              "sender": "me",
              "text": "Mẹ gửi vừa thôi, ăn hết rồi con nhờ tiếp.",
              "time": "20/08/2026 08:19",
              "timestamp": "20/08/2026 08:19",
            },
            {
              "id": "msg_010_0017",
              "sender": "them",
              "text": "Bố đi khám xong rồi, bác sĩ dặn ăn đúng bữa.",
              "time": "25/08/2026 08:10",
              "timestamp": "25/08/2026 08:10",
            },
            {
              "id": "msg_010_0018",
              "sender": "me",
              "text": "Mẹ nhắc bố mang sổ khám về cất nhé.",
              "time": "25/08/2026 08:13",
              "timestamp": "25/08/2026 08:13",
            },
            {
              "id": "msg_010_0019",
              "sender": "them",
              "text": "Mẹ để trong ngăn tủ cũ rồi.",
              "time": "25/08/2026 08:16",
              "timestamp": "25/08/2026 08:16",
            },
            {
              "id": "msg_010_0020",
              "sender": "me",
              "text": "Vâng, hôm nào con gọi hỏi bố thêm.",
              "time": "25/08/2026 08:19",
              "timestamp": "25/08/2026 08:19",
            },
            {
              "id": "msg_010_0021",
              "sender": "them",
              "text": "Ở trên ấy có mưa không con?",
              "time": "30/08/2026 08:10",
              "timestamp": "30/08/2026 08:10",
            },
            {
              "id": "msg_010_0022",
              "sender": "me",
              "text": "Mưa từ chiều, bọn con về nhà rồi.",
              "time": "30/08/2026 08:13",
              "timestamp": "30/08/2026 08:13",
            },
            {
              "id": "msg_010_0023",
              "sender": "them",
              "text": "Nhớ thu quần áo, mẹ thấy dự báo còn mưa đêm.",
              "time": "30/08/2026 08:16",
              "timestamp": "30/08/2026 08:16",
            },
            {
              "id": "msg_010_0024",
              "sender": "me",
              "text": "Vợ con thu rồi mẹ, chăn cũng khô cả.",
              "time": "30/08/2026 08:19",
              "timestamp": "30/08/2026 08:19",
            },
            {
              "id": "msg_010_0025",
              "sender": "them",
              "text": "Mẹ tìm được cuốn sổ ghi món ăn của bà.",
              "time": "03/09/2026 08:10",
              "timestamp": "03/09/2026 08:10",
            },
            {
              "id": "msg_010_0026",
              "sender": "me",
              "text": "Mẹ giữ nhé, hôm về con chụp lại mấy trang.",
              "time": "03/09/2026 08:13",
              "timestamp": "03/09/2026 08:13",
            },
            {
              "id": "msg_010_0027",
              "sender": "them",
              "text": "Vợ con hỏi món gì thì cứ bảo mẹ.",
              "time": "03/09/2026 08:16",
              "timestamp": "03/09/2026 08:16",
            },
            {
              "id": "msg_010_0028",
              "sender": "me",
              "text": "Em ấy muốn học nấu canh rau như mẹ đấy.",
              "time": "03/09/2026 08:19",
              "timestamp": "03/09/2026 08:19",
            },
            {
              "id": "msg_010_0029",
              "sender": "them",
              "text": "Bố hỏi cái đèn pin con mua để ở đâu.",
              "time": "06/09/2026 08:10",
              "timestamp": "06/09/2026 08:10",
            },
            {
              "id": "msg_010_0030",
              "sender": "me",
              "text": "Con để trong ngăn kéo dưới ti vi, cạnh dây sạc.",
              "time": "06/09/2026 08:13",
              "timestamp": "06/09/2026 08:13",
            },
            {
              "id": "msg_010_0031",
              "sender": "them",
              "text": "Mẹ thấy rồi, bố cứ đi tìm trong bếp.",
              "time": "06/09/2026 08:16",
              "timestamp": "06/09/2026 08:16",
            },
            {
              "id": "msg_010_0032",
              "sender": "me",
              "text": "Sạc bằng dây ngắn nhé mẹ, đừng dùng dây bị nứt.",
              "time": "06/09/2026 08:19",
              "timestamp": "06/09/2026 08:19",
            },
            {
              "id": "msg_010_0033",
              "sender": "them",
              "text": "Mẹ có ít bưởi mới hái, chưa gửi ngay được.",
              "time": "09/09/2026 08:10",
              "timestamp": "09/09/2026 08:10",
            },
            {
              "id": "msg_010_0034",
              "sender": "me",
              "text": "Không vội mẹ, mẹ để chỗ thoáng trước nhé.",
              "time": "09/09/2026 08:13",
              "timestamp": "09/09/2026 08:13",
            },
            {
              "id": "msg_010_0035",
              "sender": "them",
              "text": "Ừ, mẹ lau khô rồi để lên giá.",
              "time": "09/09/2026 08:16",
              "timestamp": "09/09/2026 08:16",
            },
            {
              "id": "msg_010_0036",
              "sender": "me",
              "text": "Khi nào gửi mẹ nhắn con, con xuống nhận.",
              "time": "09/09/2026 08:19",
              "timestamp": "09/09/2026 08:19",
            },
            {
              "id": "msg_010_0037",
              "sender": "them",
              "text": "Con hỏi giúp mẹ loại túi đựng thực phẩm nào dùng được ngăn đá.",
              "time": "12/09/2026 08:10",
              "timestamp": "12/09/2026 08:10",
            },
            {
              "id": "msg_010_0038",
              "sender": "me",
              "text": "Mẹ lấy loại có ghi dùng bảo quản đông lạnh nhé.",
              "time": "12/09/2026 08:13",
              "timestamp": "12/09/2026 08:13",
            },
            {
              "id": "msg_010_0039",
              "sender": "them",
              "text": "Để mẹ nhờ cô bán hàng chỉ, mẹ không đọc rõ chữ nhỏ.",
              "time": "12/09/2026 08:16",
              "timestamp": "12/09/2026 08:16",
            },
            {
              "id": "msg_010_0040",
              "sender": "me",
              "text": "Vâng, khó chọn thì mẹ gọi con trước khi mua.",
              "time": "12/09/2026 08:19",
              "timestamp": "12/09/2026 08:19",
            },
            {
              "id": "msg_010_0041",
              "sender": "them",
              "text": "Mẹ vừa tưới vườn xong, giờ mới cầm máy.",
              "time": "15/09/2026 08:10",
              "timestamp": "15/09/2026 08:10",
            },
            {
              "id": "msg_010_0042",
              "sender": "me",
              "text": "Mẹ nghỉ chút đi, nắng lên rồi đấy.",
              "time": "15/09/2026 08:13",
              "timestamp": "15/09/2026 08:13",
            },
            {
              "id": "msg_010_0043",
              "sender": "them",
              "text": "Mẹ làm từ sớm, không đứng ngoài lâu đâu.",
              "time": "15/09/2026 08:16",
              "timestamp": "15/09/2026 08:16",
            },
            {
              "id": "msg_010_0044",
              "sender": "me",
              "text": "Chiều con gọi lại, mẹ ăn cơm đúng giờ nhé.",
              "time": "15/09/2026 08:19",
              "timestamp": "15/09/2026 08:19",
            },
            {
              "id": "msg_010_0045",
              "sender": "them",
              "text": "Bố hỏi chủ nhật hai đứa có bận không.",
