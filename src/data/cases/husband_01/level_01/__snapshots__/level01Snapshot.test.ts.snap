              "timestamp": "20/09/2026 08:30",
            },
            {
              "id": "msg_010_0051",
              "sender": "them",
              "text": "Mẹ phơi được mẻ lạc, để dành cho hai đứa.",
              "time": "24/09/2026 17:00",
              "timestamp": "24/09/2026 17:00",
            },
            {
              "id": "msg_010_0052",
