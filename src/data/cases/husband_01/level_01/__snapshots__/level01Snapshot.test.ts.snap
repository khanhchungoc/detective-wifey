    "professional-network": {
      "posts": [
        {
          "author": "Bách Chut",
          "content": "Cập nhật dự án nội bộ. Thịnh bình luận: Cảm ơn cả nhóm.",
          "id": "post_001",
          "time": "14/10",
        },
        {
          "author": "Technosoft",
          "content": "Buổi chia sẻ kỹ thuật tuần sau: khả năng tiếp cận trong giao diện.",
          "id": "post_002",
          "time": "13/10",
        },
        {
          "author": "Nam Dev",
          "content": "Đã hoàn thành khóa TypeScript. Thịnh bình luận: Chúc mừng ông.",
          "id": "post_003",
          "time": "12/10",
        },
        {
          "author": "Nhân sự Technosoft",
          "content": "Tuyển lập trình viên frontend làm việc tại văn phòng. Nộp hồ sơ qua nhân sự.",
          "id": "post_004",
          "time": "11/10",
        },
        {
          "author": "Đồng nghiệp",
          "content": "Tách giao diện khỏi dữ liệu để dễ kiểm thử. Thịnh đã lưu bài viết.",
          "id": "post_005",
          "time": "10/10",
        },
        {
          "author": "Nam Dev",
          "content": "Chia sẻ cách viết kiểm thử giao diện dễ bảo trì.",
          "id": "post_006",
          "time": "22/09",
        },
        {
          "author": "Technosoft",
          "content": "Nhóm kỹ thuật mở buổi trao đổi về khả năng tiếp cận.",
          "id": "post_007",
          "time": "23/09",
        },
        {
          "author": "Bách Chut",
          "content": "Vừa hoàn thành khóa học quản lý trạng thái.",
          "id": "post_008",
          "time": "24/09",
        },
        {
          "author": "Nam Dev",
          "content": "Ghi chú sau một buổi đọc mã cùng đồng nghiệp.",
          "id": "post_009",
          "time": "25/09",
        },
        {
          "author": "Technosoft",
          "content": "Tài liệu hướng dẫn kiểm tra lỗi được cập nhật.",
          "id": "post_010",
          "time": "26/09",
        },
        {
          "author": "Bách Chut",
          "content": "Cảm ơn mọi người đã góp ý cho bản trình bày.",
          "id": "post_011",
          "time": "27/09",
        },
        {
          "author": "Nam Dev",
          "content": "Nhóm đang tuyển thêm đồng nghiệp frontend.",
          "id": "post_012",
          "time": "28/09",
        },
      ],
