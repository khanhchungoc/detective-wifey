              "timestamp": "18/09/2026 08:13",
            },
            {
              "id": "msg_010_0047",
              "sender": "them",
              "text": "Không về được thì cứ báo, mẹ chưa chuẩn bị đồ ăn đâu.",
              "time": "18/09/2026 08:16",
              "timestamp": "18/09/2026 08:16",
            },
            {
              "id": "msg_010_0048",
              "sender": "me",
              "text": "Vâng, con báo sớm để mẹ đỡ chờ.",
              "time": "18/09/2026 08:19",
              "timestamp": "18/09/2026 08:19",
            },
            {
              "id": "msg_010_0049",
              "sender": "them",
              "text": "Hai đứa cuối tuần có về không con?",
